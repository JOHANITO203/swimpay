# SwimPay production admin-auth template.
# This file documents required production shape only. Do not put real secrets in git.

NODE_ENV=production
HTTP_PORT=80
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3

POSTGRES_DB=swimpay
POSTGRES_USER=swimpay
POSTGRES_PASSWORD=
DATABASE_URL=postgres://swimpay:<POSTGRES_PASSWORD>@postgres:5432/swimpay
VALKEY_URL=redis://valkey:6379
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=SWIMPAY_EVENTS
NATS_DURABLE_PREFIX=swimpay
NATS_CONNECT_TIMEOUT_MS=2000

ADMIN_AUTH_MODE=signed_token

# Inject ADMIN_TOKEN_HMAC_SECRET from the server environment or secret store at deploy time.
# Leave blank in this committed template.
ADMIN_TOKEN_HMAC_SECRET=

# BFF / Google OAuth production values must come from the host environment or secret store.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Runtime secrets. Keep blank in this committed template.
PHONE_HMAC_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
CHECKOUT_BASE_URL=https://staging.swimpay.pro/checkout

WEBHOOK_WORKER_ENABLED=true
WEBHOOK_POLL_INTERVAL_MS=30000
WEBHOOK_WORKER_BATCH_SIZE=10
WEBHOOK_MAX_ATTEMPTS=7
WEBHOOK_REQUEST_TIMEOUT_MS=5000
WEBHOOK_RETRY_BASE_DELAY_MS=60000
WEBHOOK_RETRY_MAX_DELAY_MS=86400000

API_HOST=0.0.0.0
API_PORT=3000
SIGNAL_WORKER_HEALTH_PORT=3010
JOB_WORKER_HEALTH_PORT=3011
WEB_HOST=0.0.0.0
WEB_PORT=3001
API_BASE_URL=http://swimpay-api:3000
SWIMPAY_ALLOW_DEV_MERCHANT_SESSION=false

# Development admin auth must stay blank in production.
DEV_ADMIN_TOKEN=
DEV_ADMIN_OPERATOR_ID=
DEV_ADMIN_ROLE=
MERCHANT_INTEGRATION_BEARER_TOKEN=
SWIMPAY_ADMIN_TOKEN=
