NODE_ENV=development
HTTP_PORT=8080
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3
POSTGRES_DB=swimpay
POSTGRES_USER=swimpay
POSTGRES_PASSWORD=swimpay_dev_password
DATABASE_URL=postgres://swimpay:swimpay_dev_password@postgres:5432/swimpay
VALKEY_URL=redis://valkey:6379
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=SWIMPAY_EVENTS
NATS_DURABLE_PREFIX=swimpay
NATS_CONNECT_TIMEOUT_MS=2000

# Webhook worker local runtime.
WEBHOOK_WORKER_ENABLED=false
WEBHOOK_POLL_INTERVAL_MS=30000
WEBHOOK_WORKER_BATCH_SIZE=10
WEBHOOK_MAX_ATTEMPTS=7
WEBHOOK_REQUEST_TIMEOUT_MS=5000
WEBHOOK_RETRY_BASE_DELAY_MS=60000
WEBHOOK_RETRY_MAX_DELAY_MS=86400000

# No-notification fallback runtime.
# Creates a manual-bank-check review after an armed checkout has no signal for 120s.
# This never confirms a payment and never emits public webhooks.
NO_NOTIFICATION_FALLBACK_WORKER_ENABLED=true
NO_NOTIFICATION_FALLBACK_MIN_SECONDS=120
NO_NOTIFICATION_FALLBACK_POLL_INTERVAL_MS=30000
NO_NOTIFICATION_FALLBACK_BATCH_SIZE=25
API_HOST=0.0.0.0
API_PORT=3000
ADMIN_AUTH_MODE=dev_token
DEV_ADMIN_TOKEN=change_me_local_admin_token
DEV_ADMIN_OPERATOR_ID=dev_operator
DEV_ADMIN_ROLE=admin
ADMIN_TOKEN_HMAC_SECRET=change_me_only_for_signed_admin_tokens
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
SWIMPAY_ANDROID_GOOGLE_SERVER_CLIENT_ID=
SWIMPAY_ANDROID_STAGING_GOOGLE_SERVER_CLIENT_ID=
CHECKOUT_BASE_URL=http://localhost:3001/checkout
PHONE_HMAC_SECRET=local_dev_phone_hmac_secret
WEBHOOK_SECRET_ENCRYPTION_KEY=local_dev_webhook_secret_encryption_key
SIGNAL_WORKER_HEALTH_PORT=3010
JOB_WORKER_HEALTH_PORT=3011
WEB_HOST=0.0.0.0
WEB_PORT=3001
API_BASE_URL=http://swimpay-api:3000
CHECKOUT_MERCHANT_ID=mch_dev
MERCHANT_INTEGRATION_BEARER_TOKEN=
SWIMPAY_ALLOW_DEV_MERCHANT_SESSION=true
SWIMPAY_ADMIN_TOKEN=change_me
