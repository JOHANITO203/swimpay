{
  "name": "swimpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "agent:next": "node scripts/agent-runner.mjs",
    "agent:validate": "node scripts/agent-validate.mjs",
    "agent:summary": "node scripts/agent-summary.mjs",
    "dev:api": "npm run dev --workspace @swimpay/api",
    "dev:signal-worker": "npm run dev --workspace @swimpay/signal-worker",
    "dev:job-worker": "npm run dev --workspace @swimpay/job-worker",
    "dev:web": "npm run dev --workspace @swimpay/web",
    "smoke:runtime": "node scripts/live-runtime-smoke.mjs",
    "smoke:receiver": "node scripts/receiver-local-smoke.mjs",
    "rehearsal:evidence": "node scripts/evidence-lifecycle-rehearsal.mjs",
    "handoff:evidence-trust": "node scripts/evidence-production-trust-handoff.mjs",
    "operator:tokens": "node scripts/operator-token-helper.mjs",
    "rehearsal:evidence:signed": "vitest run tests/evidence-production-trust-signed-local-rehearsal.test.ts",
    "rehearsal:evidence:compose-signed": "node scripts/evidence-production-trust-compose-signed-rehearsal.mjs",
    "handoff:evidence-readiness": "node scripts/evidence-production-trust-readiness.mjs",
    "operator:identity-readiness": "node scripts/operator-identity-readiness.mjs",
    "production:admin-auth-preflight": "node scripts/production-admin-auth-preflight.mjs",
    "android:doctor": "node scripts/android-toolchain-check.mjs",
    "android:emulator-doctor": "node scripts/android-emulator-doctor.mjs",
    "android:test": "\"apps\\android-receiver\\android\\gradlew.bat\" -p apps/android-receiver/android :app:testDebugUnitTest --no-daemon --stacktrace --max-workers=1",
    "android:compile": "\"apps\\android-receiver\\android\\gradlew.bat\" -p apps/android-receiver/android :app:compileDebugKotlin --no-daemon --stacktrace --max-workers=1",
    "android:screenshot:record": "\"apps\\android-receiver\\android\\gradlew.bat\" -p apps/android-receiver/android :app:recordRoborazziDebug --no-daemon --stacktrace --max-workers=1",
    "android:screenshot:verify": "\"apps\\android-receiver\\android\\gradlew.bat\" -p apps/android-receiver/android :app:verifyRoborazziDebug --no-daemon --stacktrace --max-workers=1",
    "android:visual:record": "npm run android:screenshot:record",
    "android:visual:verify": "npm run android:screenshot:verify",
    "android:visual:accept": "npm run android:screenshot:record && npm run android:screenshot:verify",
    "android:assemble:staging": ".\\apps\\android-receiver\\android\\gradlew.bat -p apps/android-receiver/android :app:assembleStaging --no-daemon --stacktrace --max-workers=1",
    "android:assemble:debug-vps": ".\\apps\\android-receiver\\android\\gradlew.bat -p apps/android-receiver/android :app:assembleDebug \"-PswimpayBackendBaseUrl=https://staging.swimpay.pro\" \"-PswimpayGoogleServerClientId=983049539084-8k91arvoocd6d1q8fbjq1auvmigkeg6u.apps.googleusercontent.com\" --no-daemon --stacktrace --max-workers=1",
    "checkout:screenshot:record": "tsx scripts/checkout-browser-baselines.ts record",
    "checkout:screenshot:verify": "tsx scripts/checkout-browser-baselines.ts verify",
    "backend:doctor": "node scripts/local-backend-doctor.mjs",
    "test:replay": "node scripts/p0-deterministic-replay.mjs",
    "test:matching": "vitest run packages/matching-core/src",
    "test:privacy": "vitest run packages/security/src packages/observability/src packages/contracts/src/android-receiver.test.ts apps/api/src/signals.test.ts",
    "test:webhooks": "vitest run apps/job-worker/src/webhooks.test.ts packages/swimpay-node/src/index.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "eslint": "^9.25.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "nats": "^2.29.3",
    "pg": "^8.20.0"
  }
}
