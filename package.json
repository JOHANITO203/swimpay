{
  "name": "swimpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "agent:next": "node scripts/agent-runner.mjs",
    "agent:validate": "node scripts/agent-validate.mjs",
    "agent:summary": "node scripts/agent-summary.mjs",
    "dev:api": "npm run dev --workspace @swimpay/api",
    "dev:signal-worker": "npm run dev --workspace @swimpay/signal-worker",
    "dev:job-worker": "npm run dev --workspace @swimpay/job-worker",
    "dev:web": "npm run dev --workspace @swimpay/web",
    "smoke:runtime": "node scripts/live-runtime-smoke.mjs",
    "smoke:receiver": "node scripts/receiver-local-smoke.mjs",
    "rehearsal:evidence": "node scripts/evidence-lifecycle-rehearsal.mjs",
    "handoff:evidence-trust": "node scripts/evidence-production-trust-handoff.mjs",
    "operator:tokens": "node scripts/operator-token-helper.mjs",
    "rehearsal:evidence:signed": "vitest run tests/evidence-production-trust-signed-local-rehearsal.test.ts",
    "rehearsal:evidence:compose-signed": "node scripts/evidence-production-trust-compose-signed-rehearsal.mjs",
    "android:doctor": "node scripts/android-toolchain-check.mjs",
    "android:emulator-doctor": "node scripts/android-emulator-doctor.mjs",
    "backend:doctor": "node scripts/local-backend-doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "eslint": "^9.25.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "nats": "^2.29.3",
    "pg": "^8.20.0"
  }
}
