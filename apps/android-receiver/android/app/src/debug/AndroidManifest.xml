<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <!-- Debug/operator dry-run visibility for one explicitly selected package. This is not trust. -->
        <package android:name="ru.sberbankmobile" />
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:networkSecurityConfig="@xml/debug_network_security_config"
        android:usesCleartextTraffic="true">
        <receiver
            android:name=".DebugSmokeBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.swimpay.receiver.DEBUG_SMOKE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
