<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <!-- Debug/operator dry-run visibility for explicitly supported bank targets. This is not trust. -->
        <package android:name="ru.sberbankmobile" />
        <package android:name="com.idamob.tinkoff.android" />
        <package android:name="ru.vtb24.mobilebanking.android" />
        <package android:name="ru.alfabank.mobile.android" />
        <package android:name="ru.gazprombank.android.mobilebank.app" />
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:networkSecurityConfig="@xml/debug_network_security_config"
        android:usesCleartextTraffic="true">
        <receiver
            android:name=".DebugSmokeBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.swimpay.receiver.DEBUG_SMOKE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
