{
  // ── Le site SwimPay, servi par un Worker à assets statiques ──
  //
  // Le dossier ./public tient trois fichiers : index.html, favicon.ico et
  // og.jpg. Cloudflare les sert depuis son réseau ; le Worker ne s'interpose
  // que pour poser les en-têtes de sécurité, ce qu'un hébergement statique nu
  // ne fait pas.
  //
  // Deux valeurs à vérifier avant la première mise en ligne :
  //   name              devient <name>.<sous-domaine>.workers.dev
  //   compatibility_date fige le comportement du runtime : ne pas l'avancer
  //                      sans relire les notes de version.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swimpay-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Le site est UNE page routée par ancre : toute adresse inconnue doit
    // rendre index.html plutôt qu'un 404, sinon /business tombe à côté.
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true }
}
