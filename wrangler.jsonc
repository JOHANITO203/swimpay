{
  // ── SwimPay — le site, servi par un Worker à assets statiques ──
  //
  // Ce fichier est À LA RACINE du dépôt exprès : Cloudflare Workers Builds le
  // cherche là par défaut. Aucun « root directory » à renseigner dans le
  // tableau de bord, aucune commande de build à écrire — la branche se
  // déploie telle quelle.
  //
  // Les chemins pointent dans deploy/ pour ne rien dupliquer : le site pèse
  // 1,9 Mo, le recopier à la racine ferait deux copies à maintenir.
  //
  // Trois valeurs à connaître :
  //   name               donne swimpay-site.<sous-domaine>.workers.dev
  //   main               le Worker ne fabrique aucune page ; il pose les
  //                      en-têtes de sécurité, et rien d'autre
  //   compatibility_date fige le comportement du runtime. Ne pas l'avancer
  //                      sans relire les notes de version.
  "name": "swimpay-site",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-08-31",

  "assets": {
    "directory": "deploy/public",
    "binding": "ASSETS",
    // Le site est UNE page routée par ancre : toute adresse inconnue doit
    // rendre index.html plutôt qu'un 404, sinon /business tombe à côté.
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true }
}
